# Public client configuration. The anon key is intentionally browser-safe when RLS is enabled.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Optional. Leave unset locally. GitHub Actions infers /<repository-name>/ automatically.
# VITE_BASE_PATH=/roadfit/

# Optional locally. The Pages workflow sets this to the deployed repository.
# VITE_REPOSITORY_URL=https://github.com/YOUR_ACCOUNT/roadfit
